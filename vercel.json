{
  "routes": [
    {
      "src": "/booking.js",
      "has": [{ "type": "host", "value": "app.cordevra.com" }],
      "dest": "/app/booking.js"
    },
    {
      "src": "/home.js",
      "has": [{ "type": "host", "value": "app.cordevra.com" }],
      "dest": "/app/home.js"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "app.cordevra.com" }],
      "dest": "/app/index.html",
      "headers": { "X-Robots-Tag": "noindex" }
    }
  ]
}
